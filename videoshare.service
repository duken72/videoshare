[Unit]
Description=videoshare - side-by-side video comparison app
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/opt/videoshare
Environment="VIDEO_DIR=/path/to/your/videos"
ExecStart=/opt/videoshare/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
